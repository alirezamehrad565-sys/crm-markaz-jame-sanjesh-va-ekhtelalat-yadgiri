{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markaz-Jame-Desktop",
  "version": "1.27.3",
  "identifier": "ir.sdt144.center.desktop",
  "build": {
    "frontendDist": "boot-dist",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "مرکز جامع سنجش، آموزش، توان‌بخشی و مداخلات بهنگام",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/engine/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Persian",
          "English"
        ]
      }
    }
  }
}
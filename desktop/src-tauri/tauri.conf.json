{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markaz-Jame-Desktop",
  "version": "1.27.87",
  "identifier": "ir.sdt144.center.desktop",
  "build": {
    "frontendDist": "boot-dist",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "مرکز جامع سنجش، آموزش، توان‌بخشی و مداخلات بهنگام",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-w54VY4KCDeMS6dJ7CwCGYBCZa6jgjeiWgh6x09bbL6s='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/alirezamehrad565-sys/crm-markaz-jame-sanjesh-va-ekhtelalat-yadgiri/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/engine/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Persian",
          "English"
        ],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
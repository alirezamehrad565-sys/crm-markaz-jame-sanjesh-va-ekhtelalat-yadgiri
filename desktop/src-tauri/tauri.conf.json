{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "مرکز جامع — نسخهٔ میز",
  "version": "1.25.75",
  "identifier": "ir.sdt144.center.desktop",
  "build": {
    "frontendDist": "../../public",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "windows": [
      {
        "title": "مرکز جامع سنجش، آموزش، توان‌بخشی و مداخلات بهنگام",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/workerd"],
    "resources": ["resources/engine/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Persian", "English"]
      }
    }
  }
}

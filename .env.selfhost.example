# ─────────────────────────────────────────────────────────────
# نمونهٔ .env سلف‌هاست — کپی کنید به .env و مقدارها را تنظیم کنید:
#   cp .env.selfhost.example .env
# هیچ‌کدام اجباری نیستند؛ سامانه بدون بات هم کامل کار می‌کند.
# ─────────────────────────────────────────────────────────────

# نام مرکز — در سربرگ پیام‌ها و اعلان‌ها استفاده می‌شود
CLINIC_NAME=مرکز جامع

# آدرس عمومی سایت (برای لینک‌های داخل پیام‌های بله، مثل فرم خانواده/معلم)
# روی لوکال خالی بگذارید؛ روی سرور: https://app.example.ir
PUBLIC_BASE_URL=

# — بات بله (اختیاری) —
# توکن بات از BotFather بله؛ رمز وب‌هوک: یک رشتهٔ تصادفی خودتان بسازید
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=

# — رمز امضای JWT/دانلود (اختیاری اما توصیه‌شده؛ حداقل ۱۶ کاراکتر) —
# اگر خالی بماند، رمز جلسه به‌صورت خودکار در دیتابیس ساخته و نگهداری می‌شود.
AUTH_SECRET=

# — فقط برای استقرار عمومی با لایهٔ Caddy —
PUBLIC_DOMAIN=app.example.ir

# — دیباگ: تریگر دستی کرون از /__scheduled —
CRON_MANUAL=0
